{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Foundry in Firefox",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:30000",
      "webRoot": "${workspaceFolder}",
      // This tells VS Code where to find your Firefox installation
      "executable": "C:\\Program Files\\Mozilla Firefox\\firefox.exe",
      // These are the arguments passed to Firefox on startup
      "runtimeArgs": ["-start-debugger-server", "9222", "-new-window"],
      "pathMappings": [
        {
          "url": "http://localhost:30000/modules/dnd5e-divinitypoints/",
          "path": "${workspaceFolder}"
        }
      ]
    },
    {
      // Launches a fresh Chrome tab pointed at your Foundry instance.
      // Requires Chrome to be closed (or use a separate profile).
      // Good for a clean debug session.
      "name": "Launch Foundry in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:30000",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/modules/dnd5e-divinitypoints/*": "${workspaceFolder}/*"
      },
      // Opens DevTools automatically so you don't have to press F12
      "runtimeArgs": ["--auto-open-devtools-for-tabs"]
    }
  ]
}
